# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
*.swp
server_*

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
vendor/
bin/

.idea/
*.iml
.vscode/settings.json

tmp/
tmpFiles/
*.tmp
logs/
files/
lastupdate.tmp
commentsRouter*.go

# ignore build result
casdoor
server

# include helm-chart
!manifests/casdoor

# ========= 新增：前端与环境变量等必须忽略的配置 =========
# Node.js 依赖 (前端打包依赖，绝不能提交)
node_modules/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 环境变量文件 (防止数据库密码泄露！)
.env
.env.local
*.env
# 应用配置含数据库连接凭据，使用 app.conf.template 作为模板
conf/app.conf

# 系统生成的缓存
.DS_Store
Thumbs.db
.mysql_data/*

# ========= 安全：本地密钥与过程文件 =========
# JWT 签名私钥与证书（运行时自动生成或手动配置，禁止入库）
object/token_jwt_key.key
object/token_jwt_key.pem

# 本地 AI Agent 配置（非工程文件）
.trae/

# 本地 Docker 环境信息（过程产物）
docker_info.txt
